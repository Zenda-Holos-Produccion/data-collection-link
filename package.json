{
  "name": "enlace-dinamico-whatsapp",
  "version": "0.3.0",
  "description": "Forms whose response channel is a WhatsApp conversation: a configurable button opens a dialog of N fields, invites a recipient, and persists their photos and report to whatever storage the host application defines.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "react": "^19",
    "typescript": "^5.6",
    "vitest": "^4"
  }
}
