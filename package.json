{
  "name": "data-collection-link",
  "version": "0.6.1",
  "description": "Data collection links: a WhatsApp or Telegram chat that works as a form for someone without an account. The operator opens a case from a dialog of N fields defined in a template; the recipient reports text and photos in the chat, persisted to whatever storage the host application defines.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "react": "^19",
    "typescript": "^5.6",
    "vitest": "^4"
  }
}
